x = 'abcdefghij'
sp = [str(i) for i in x] #создаем список с 20-ти ричными буквами

def twenty(a):
    new = ''
    while a > 0:
        rest = str(a % 20)
        if int(rest) <= 9:
            new = rest + new
        if int(rest) > 9:
            new = sp[int(rest) - 10] + new
        a //= 20
    return new

counter = 0



for i in range(1, 1001):
    num = twenty(i)
    if len(num) == 3 and num[0] == '1' and num[2] == 'j':
        counter += 1
print(counter)
